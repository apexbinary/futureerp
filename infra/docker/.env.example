# Copy to `.env` in this directory to override the compose defaults.
# These are LOCAL DEVELOPMENT credentials only — never use them in production.

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=future_erp

# Host port mapped to the container's 5432. 5433 avoids clashing with a
# machine-local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
