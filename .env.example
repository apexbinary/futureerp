# ─── Copy to .env and fill in. NEVER commit the real .env. ───────────────

# Which plane/role this process runs as: control-plane | node-runtime | agent
ERP_ROLE=node-runtime

# Deployment topology: cloud | self-hosted
ERP_DEPLOYMENT=cloud

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=future_erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me

# ─── Django ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Control plane connection (used by node-runtime + agent) ─────────────
CONTROL_PLANE_URL=https://control.future-erp.local
# Public key used to VERIFY signed licenses/artifacts (safe to ship).
CONTROL_PLANE_PUBLIC_KEY_PATH=./signing-keys/control-plane.pub

# ─── Agent (self-hosted only) ────────────────────────────────────────────
AGENT_CHECKIN_INTERVAL_SECONDS=300
AGENT_UPDATE_MODE=auto   # auto | approve-first
